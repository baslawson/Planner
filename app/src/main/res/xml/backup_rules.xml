<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Auto Backup, Android 8–11 (android:fullBackupContent). Only exclusions, so everything else is backed up as
    before these rules (no_backup, which holds the Nextcloud login, and the caches never are).
    pending_alarms: the reminders this phone has set (reminders/AlarmLedger). Another phone hasn't set them, and a copy
    restored there would show reminders already seen here as "Missed" after its first reboot.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="pending_alarms.xml" />
    <!-- A6-9: alarm_window, how far ahead this phone has set them, goes with pending_alarms: another phone sets its own.
         delivered_alarms and reminder_zone are kept on purpose: they describe the restored reminders (which already
         rang, so none rings twice; the zone their times were set in). -->
    <exclude domain="sharedpref" path="alarm_window.xml" />
    <!-- A6-9: App lock is this phone's choice (see AppLock): a new phone starts unlocked, as with Planner's own backups. -->
    <exclude domain="sharedpref" path="app_lock.xml" />
    <!-- support_prompt: "already shown" belongs to this install, so a fresh one (reinstall, new phone) stays quiet.
         updates: a download made on this phone (its file isn't carried over). -->
    <exclude domain="sharedpref" path="support_prompt.xml" />
    <exclude domain="sharedpref" path="updates.xml" />
    <!-- SR-5: the last crash (data/BugReport CrashLog) is this phone's, for its own bug report; another phone, or a later
         version, would offer it as its own. -->
    <exclude domain="file" path="last-crash.txt" />
    <exclude domain="file" path="last-crash.sent" />
</full-backup-content>
