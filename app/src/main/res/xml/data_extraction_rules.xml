<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Auto Backup and device-to-device transfer, Android 12 and later (android:dataExtractionRules). The same as
    backup_rules.xml: only exclusions, so everything else goes as before these rules. pending_alarms stays on this phone:
    its reminders were set here, and a copy on another phone would show ones already seen as "Missed" after a reboot.
    A6-9: so do alarm_window (how far ahead this phone has set them) and app_lock (App lock is this phone's choice, see
    AppLock). delivered_alarms and reminder_zone go on purpose: they describe the restored reminders (which already rang,
    the zone their times were set in). support_prompt and updates stay too: a fresh install asks nothing, and a download
    made here isn't carried over.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pending_alarms.xml" />
        <exclude domain="sharedpref" path="alarm_window.xml" />
        <exclude domain="sharedpref" path="app_lock.xml" />
        <exclude domain="sharedpref" path="support_prompt.xml" />
        <exclude domain="sharedpref" path="updates.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pending_alarms.xml" />
        <exclude domain="sharedpref" path="alarm_window.xml" />
        <exclude domain="sharedpref" path="app_lock.xml" />
        <exclude domain="sharedpref" path="support_prompt.xml" />
        <exclude domain="sharedpref" path="updates.xml" />
    </device-transfer>
</data-extraction-rules>
