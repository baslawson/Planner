<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_week_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_week_heading" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center_vertical" android:text="@string/widget_week"
            android:textColor="#A5E5DC" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_week_refresh" android:layout_width="48dp" android:layout_height="40dp"
            android:gravity="center" android:text="↻" android:textSize="26sp" android:textColor="#A5E5DC"
            android:contentDescription="@string/widget_week_refresh" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_week_days" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" />
</LinearLayout>
