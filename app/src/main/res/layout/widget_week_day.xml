<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_day" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:orientation="horizontal" android:paddingTop="2dp" android:paddingBottom="2dp">
    <TextView android:id="@+id/widget_day_name" android:layout_width="56dp" android:layout_height="match_parent"
        android:gravity="top" android:textColor="#A5E5DC" android:textSize="14sp" android:maxLines="2" />
    <TextView android:id="@+id/widget_day_entries" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="match_parent" android:gravity="top" android:textColor="#EEEEEE" android:textSize="13sp"
        android:ellipsize="end" />
</LinearLayout>
