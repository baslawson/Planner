<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_event" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
    <TextView android:id="@+id/widget_event_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_event_time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#C4D2D0" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
