<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Updates from GitHub: Android still asks before installing (Settings → Updates). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Calendar sync step 3: read-only; asked for only when the user taps "Show phone calendars". -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact alarms, which alone let a reminder start a ringing alarm (in silent and vibrate mode too). From Android 13,
         USE_EXACT_ALARM is granted at install and can't be turned off, as for alarm and calendar apps; from Android 14
         SCHEDULE_EXACT_ALARM is off until the user allows it, so it is kept for Android 12 and lower only. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".ItineraryApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Itinerary">
        <!--
            The app handles these configuration changes itself instead of being recreated for them. Everything here is
            Compose, which re-reads the configuration and recomposes, so nothing needs rebuilding from resources.
            Without this, any of these changes destroys the activity and every screen's state with it: an open event
            editor loses the title, attachments and reminders typed into it, and a document scan in progress is thrown
            away (found and fixed 20 Sep 2026). That covers a hardware keyboard or navigation device coming or going,
            Bold text (fontWeightAdjustment), wide-colour mode and the grammatical gender setting too (U-N4). What Planner
            was asked to open survives a recreation that still happens (MainActivity.onSaveInstanceState), and unfinished
            editors and scans also have a private durable draft for process-death recovery.
            adjustResize: the screens lift themselves above the keyboard (imePadding). Left unset, Android also panned
            the window up when a low field (a checklist item) was focused: the pinned buttons ended up far above it.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|fontScale|fontWeightAdjustment|uiMode|colorMode|density|locale|layoutDirection|grammaticalGender">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="application/ics" />
                <data android:mimeType="application/icalendar" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Files and photos of any type, one or several, attached to a new event, task, bill or note (SharedFiles). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Launcher shortcuts (res/xml/shortcuts.xml) land here, in a task of its own, and are passed on to Planner's
            task (EntryShortcuts.kt). Android starts a static shortcut with NEW_TASK | CLEAR_TASK; aimed at MainActivity
            that closed the running Planner and any editor open in it. Exported like MainActivity, which takes the same
            three actions.
        -->
        <activity android:name=".EntryShortcutActivity" android:exported="true" android:taskAffinity=""
            android:excludeFromRecents="true" android:noHistory="true" android:theme="@android:style/Theme.NoDisplay" />

        <!-- App lock (ui/AppLock.kt): covers Planner until the user unlocks; dialogs and editors stay open underneath. -->
        <activity android:name=".LockActivity" android:exported="false" android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|fontScale|fontWeightAdjustment|uiMode|colorMode|density|locale|layoutDirection|grammaticalGender" />

        <!-- Its own task (no affinity): opening it from a notification must not bring Planner's screen forward under it,
             which would show the App lock screen over the snooze choices. -->
        <activity android:name=".reminders.SnoozeActivity" android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- RB-3: the three reminder receivers, the ringing service and BootReceiver are directBootAware, so a reminder
             rings after a reboot before the phone is first unlocked (from the snapshot in device-protected storage, see
             LockedAlarm). The button receivers (Done, Mark paid) are not: they change the database, which can't be read
             until then, and their buttons ask for the unlock first (addDataAction). -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <receiver android:name=".reminders.TaskActionReceiver" android:exported="false" />

        <receiver android:name=".reminders.TaskReminderReceiver" android:directBootAware="true" android:exported="false" />
        <receiver android:name=".reminders.NoteReminderReceiver" android:directBootAware="true" android:exported="false" />
        <receiver android:name=".reminders.NoteActionReceiver" android:exported="false" />

        <receiver android:name=".reminders.BillPaymentReceiver" android:exported="false" />
        <receiver android:name=".reminders.SnoozeReceiver" android:exported="false" />

        <!-- Plays the looping alarm sound; a media-playback foreground service keeps it alive while it rings. -->
        <service
            android:name=".reminders.AlarmService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".reminders.BootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".widget.TodayWidget" android:exported="false" android:label="@string/widget_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- Lets the camera app write photos into, and viewer apps read files from, our private storage. -->
        <!-- ML Kit (document text) starts when a document is first read (DocumentText), not at every start of the app:
             a reminder, the widget or a boot needs none of it. -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />
        <!-- A6-8: ML Kit sends usage logs to Google through Google's data transport, whose only way out is the CCT backend
             named in this service's meta-data. Without the service no backend is found: each log is dropped when made
             ("Transport backend 'cct' is not registered"), and any queued by an older version is deleted unsent. Text
             recognition runs on the phone and doesn't need it. The transport's scheduler service and receiver stay (not
             exported; with no backend they have nothing to send). -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
