#!/bin/sh
# Scans the commits about to be pushed for secrets (keys, passwords, tokens) with gitleaks, and stops the push if it
# finds any. Turned on per clone with: git config core.hooksPath tools/git-hooks
# GitHub runs the same scan on every push and release (.github/workflows/gitleaks.yml).

gitleaks=$(command -v gitleaks 2>/dev/null)
if [ -z "$gitleaks" ]; then
    # winget installs it here; a shell started before the install doesn't have it on PATH yet.
    for candidate in "$LOCALAPPDATA/Microsoft/WinGet/Links/gitleaks.exe" \
        "$LOCALAPPDATA"/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_*/gitleaks.exe; do
        [ -x "$candidate" ] && gitleaks=$candidate && break
    done
fi
if [ -z "$gitleaks" ]; then
    echo "pre-push: gitleaks not found, so the push is stopped. Install it (winget install Gitleaks.Gitleaks)." >&2
    exit 1
fi

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    # A branch being deleted pushes no commits.
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        # A new branch or tag: every commit not already on the remote.
        range="$local_sha --not --remotes"
    else
        range="$remote_sha..$local_sha"
    fi
    # gitleaks reports "no leaks" when git can't read the range, so the range is checked here first.
    count=$(git rev-list --count $range 2>/dev/null) || {
        echo "pre-push: couldn't list the commits being pushed for $local_ref, so the push is stopped." >&2
        status=1; continue
    }
    [ "$count" -eq 0 ] && continue
    if ! "$gitleaks" git . --log-opts="$range" --redact --no-banner; then
        echo "pre-push: gitleaks found a possible secret in $local_ref; the push is stopped. Remove it from the commits first." >&2
        status=1
    fi
done
exit $status
